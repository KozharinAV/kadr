PORT=3000
DATABASE_URL=postgres://kadr:kadr@localhost:55432/kadr
REDIS_URL=redis://localhost:26379
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
S3_ENDPOINT=http://localhost:19100
# Адрес, который открывает браузер. Пусто — совпадает с S3_ENDPOINT.
# В compose API ходит на http://minio:9000, а ссылки подписывает на http://localhost:19100.
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=kadr
S3_SECRET_KEY=kadrsecret
S3_BUCKET=kadr
S3_REGION=ru-central1
S3_FORCE_PATH_STYLE=true
ADMIN_EMAIL=admin@kadr.local
ADMIN_PASSWORD=Admin123!
